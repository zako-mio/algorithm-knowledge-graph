  "nodes": [
    {"id": "kmp", "name": "KMP算法", "group_id": "G-C-1", "stage": "intermediate", "priority": "P0", "brief": "线性时间字符串匹配，利用前缀函数(pi数组)避免回溯，O(n+m)", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/kmp/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/prefix-function.html", "verified": true}, {"type": "book", "ref": "CPH ch26 String algorithms (p253-260)", "verified": true}]},
    {"id": "z-function", "name": "Z函数", "group_id": "G-C-1", "stage": "intermediate", "priority": "P1", "brief": "Z数组z[i]表示S与S[i..]的最长公共前缀长度，线性构造，可用于匹配与周期判断", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/z-func/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/z-function.html", "verified": true}]},
    {"id": "boyer-moore", "name": "Boyer-Moore", "group_id": "G-C-1", "stage": "advanced", "priority": "P2", "brief": "基于坏字符与好后缀规则的字符串匹配算法，子线性平均复杂度", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/bm/", "verified": true}]},
    {"id": "string-hash", "name": "字符串哈希", "group_id": "G-C-1", "stage": "intermediate", "priority": "P0", "brief": "将字符串映射为多项式哈希值，O(1)比较子串哈希，需双哈希防碰撞", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/hash/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/string-hashing.html", "verified": true}, {"type": "book", "ref": "CPH ch26 String algorithms (p253-260)", "verified": true}]},
    {"id": "rabin-karp", "name": "Rabin-Karp", "group_id": "G-C-1", "stage": "intermediate", "priority": "P1", "brief": "基于滚动哈希的字符串匹配，O(n+m)期望，字符串哈希的匹配应用", "sources": [{"type": "cpalg", "url": "https://cp-algorithms.com/string/rabin-karp.html", "verified": true}, {"type": "oiwiki", "url": "https://oi-wiki.org/string/hash/", "verified": true}]},
    {"id": "trie", "name": "Trie字典树", "group_id": "G-C-2", "stage": "intermediate", "priority": "P0", "brief": "树形结构存储多字符串公共前缀，O(L)插入查询，AC自动机与可持久化Trie的基础", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/trie/", "verified": true}, {"type": "book", "ref": "CPH ch26 String algorithms (p253-260)", "verified": true}]},
    {"id": "ac-automaton", "name": "AC自动机", "group_id": "G-C-2", "stage": "advanced", "priority": "P1", "brief": "Trie+KMP失配指针，多模式串匹配自动机，O(n+m+z)", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/ac-automaton/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/aho_corasick.html", "verified": true}]},
    {"id": "suffix-array", "name": "后缀数组", "group_id": "G-C-3", "stage": "advanced", "priority": "P1", "brief": "SA+rank+height数组，对字符串所有后缀排序，配合LCP做子串统计与匹配", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/sa/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/suffix-array.html", "verified": true}, {"type": "book", "ref": "CPH ch26 String algorithms (p253-260)", "verified": true}]},
    {"id": "suffix-array-optimal", "name": "最优原地后缀数组", "group_id": "G-C-3", "stage": "frontier", "priority": "P3", "brief": "线性时间O(n)且O(1)额外空间构造后缀数组的变体(SA-IS等)", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/sa-optimal-inplace/", "verified": true}]},
    {"id": "suffix-tree", "name": "后缀树", "group_id": "G-C-3", "stage": "advanced", "priority": "P2", "brief": "压缩所有后缀的Trie，Ukkonen算法O(n)在线构造，SA/SAM的等价结构", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/suffix-tree/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/suffix-tree-ukkonen.html", "verified": true}]},
    {"id": "suffix-bst", "name": "后缀平衡树", "group_id": "G-C-3", "stage": "frontier", "priority": "P3", "brief": "用平衡BST维护后缀排序，支持动态插入删除字符的后缀结构", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/suffix-bst/", "verified": true}]},
    {"id": "suffix-automaton", "name": "后缀自动机(SAM)", "group_id": "G-C-4", "stage": "advanced", "priority": "P2", "brief": "识别字符串所有子串的最小DFA，O(n)在线构造，endpos等价类", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/sam/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/suffix-automaton.html", "verified": true}]},
    {"id": "general-sam", "name": "广义后缀自动机", "group_id": "G-C-4", "stage": "frontier", "priority": "P2", "brief": "多字符串的SAM，Trie上建SAM或离线BFS建，支持多串子串查询", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/general-sam/", "verified": true}]},
    {"id": "seq-automaton", "name": "序列自动机", "group_id": "G-C-4", "stage": "advanced", "priority": "P2", "brief": "next数组记录每个位置后各字符出现位置，O(n|Σ|)构造，子序列匹配自动机", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/seq-automaton/", "verified": true}]},
    {"id": "manacher", "name": "Manacher算法", "group_id": "G-C-5", "stage": "intermediate", "priority": "P1", "brief": "O(n)求最长回文子串，利用回文对称性避免重复扩展", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/manacher/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/manacher.html", "verified": true}, {"type": "book", "ref": "CPH ch26 String algorithms (p253-260)", "verified": true}]},
    {"id": "palindrome-automaton", "name": "回文自动机(PAM)", "group_id": "G-C-5", "stage": "advanced", "priority": "P2", "brief": "存储字符串所有回文子串的最小DFA，O(n)构造，fail链指向最长回文后缀", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/pam/", "verified": true}]},
    {"id": "lyndon-factorization", "name": "Lyndon分解", "group_id": "G-C-6", "stage": "advanced", "priority": "P2", "brief": "Duval算法O(n)将字符串分解为字典序递减的Lyndon串，用于最小表示法", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/lyndon/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/lyndon_factorization.html", "verified": true}]},
    {"id": "main-lorentz", "name": "Main-Lorentz", "group_id": "G-C-6", "stage": "frontier", "priority": "P3", "brief": "O(n log n)找出字符串所有平方串(重复子串)的出现位置", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/main-lorentz/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/string/main_lorentz.html", "verified": true}]},
    {"id": "minimal-string", "name": "最小表示法", "group_id": "G-C-6", "stage": "advanced", "priority": "P2", "brief": "O(n)求循环字符串字典序最小的起始位置，基于Lyndon分解或双指针", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/string/minimal-string/", "verified": true}]},
    {"id": "sieve-eratosthenes", "name": "埃氏筛", "group_id": "G-C-7", "stage": "basic", "priority": "P0", "brief": "O(n log log n)筛素数，标记合数，基础素数筛法", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/sieve/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/sieve-of-eratosthenes.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "sieve-linear", "name": "线性筛(欧拉筛)", "group_id": "G-C-7", "stage": "intermediate", "priority": "P0", "brief": "O(n)筛素数，每个合数只被最小质因子筛一次，可同时求积性函数", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/sieve/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/prime-sieve-linear.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "euclidean-gcd", "name": "欧几里得算法(GCD)", "group_id": "G-C-7", "stage": "basic", "priority": "P0", "brief": "辗转相除法求最大公约数，O(log min(a,b))，数论基础工具", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/euclidean/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/euclid-algorithm.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "ext-euclidean", "name": "扩展欧几里得", "group_id": "G-C-7", "stage": "intermediate", "priority": "P0", "brief": "求ax+by=gcd(a,b)的一组整数解，模逆元与线性方程的基础", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/euclidean/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/extended-euclid-algorithm.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "mod-arithmetic", "name": "模算术", "group_id": "G-C-7", "stage": "basic", "priority": "P0", "brief": "模意义下加减乘除运算，取模与负数处理，竞赛必备基础", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/mod-arithmetic/", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "modular-inverse", "name": "模逆元", "group_id": "G-C-7", "stage": "intermediate", "priority": "P0", "brief": "求a在模m下的逆元，方法：扩展欧几里得/费马小定理/线性递推", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/inverse/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/module-inverse.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "binary-exponentiation", "name": "快速幂", "group_id": "G-C-7", "stage": "basic", "priority": "P0", "brief": "O(log n)计算a^n，二进制取幂，模意义下核心工具", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/binary-exponentiation/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/binary-exp.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "euler-totient", "name": "欧拉函数", "group_id": "G-C-7", "stage": "intermediate", "priority": "P0", "brief": "phi(n)表示1~n中与n互素的数个数，积性函数，欧拉定理基础", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/euler-totient/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/phi-function.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "fermat-little-theorem", "name": "费马小定理", "group_id": "G-C-7", "stage": "intermediate", "priority": "P0", "brief": "p素数时a^(p-1)≡1(mod p)，模逆元与素性检测的理论基础", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/fermat/", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "prime-test-basic", "name": "素数判定(试除)", "group_id": "G-C-7", "stage": "basic", "priority": "P0", "brief": "O(sqrt(n))试除法判定素数，基础方法，大数用Miller-Rabin", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/prime/", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "crt", "name": "中国剩余定理(CRT)", "group_id": "G-C-8", "stage": "intermediate", "priority": "P0", "brief": "求解同余方程组，将模互素的大模数分解为小模数合并，exCRT处理不互素", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/crt/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/chinese-remainder-theorem.html", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "bsgs", "name": "BSGS(大步小步)", "group_id": "G-C-8", "stage": "advanced", "priority": "P1", "brief": "O(sqrt(p))求离散对数a^x≡b(mod p)，baby-step giant-step算法", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/discrete-logarithm/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/discrete-log.html", "verified": true}]},
    {"id": "primitive-root", "name": "原根", "group_id": "G-C-8", "stage": "advanced", "priority": "P1", "brief": "模p下阶为phi(p)的元素g，NTT与离散对数的基础，最小原根O(sqrt)求解", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/primitive-root/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/primitive-root.html", "verified": true}]},
    {"id": "discrete-root", "name": "离散k次根", "group_id": "G-C-8", "stage": "advanced", "priority": "P2", "brief": "求x^k≡a(mod p)的解，基于原根将问题转化为离散对数", "sources": [{"type": "cpalg", "url": "https://cp-algorithms.com/algebra/discrete-root.html", "verified": true}, {"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/primitive-root/", "verified": true}]},
    {"id": "lucas-theorem", "name": "卢卡斯定理", "group_id": "G-C-8", "stage": "advanced", "priority": "P0", "brief": "C(n,m) mod p当p为素数时分位计算，O(p log n)，大组合数取小素模", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/lucas/", "verified": true}, {"type": "book", "ref": "CPH ch21 Number theory (p207-216)", "verified": true}]},
    {"id": "extended-lucas", "name": "扩展卢卡斯(exLucas)", "group_id": "G-C-8", "stage": "advanced", "priority": "P1", "brief": "C(n,m) mod p当p为合数时，分解质因子+CRT合并，处理任意模数组合数", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/lucas/", "verified": true}]},
    {"id": "mobius-inversion", "name": "莫比乌斯反演", "group_id": "G-C-8", "stage": "advanced", "priority": "P1", "brief": "利用莫比乌斯函数mu进行数论反演，将gcd计数问题转化为求和", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/mobius/", "verified": true}]},
    {"id": "quadratic-residue", "name": "二次剩余", "group_id": "G-C-8", "stage": "advanced", "priority": "P2", "brief": "求x^2≡a(mod p)的解，Cipolla算法O(log p)，Tonelli-Shanks", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/quad-residue/", "verified": true}]},
    {"id": "pollard-rho", "name": "Pollard-Rho", "group_id": "G-C-9", "stage": "advanced", "priority": "P1", "brief": "期望O(n^1/4)大整数分解，基于生日悖论与伪随机序列环检测", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/pollard-rho/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/factorization.html", "verified": true}]},
    {"id": "miller-rabin", "name": "Miller-Rabin", "group_id": "G-C-9", "stage": "advanced", "priority": "P1", "brief": "概率性素性测试O(k log n)，基于费马小定理与二次探测定理", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/number-theory/prime/", "verified": true}, {"type": "cpalg", "url": "https://cp-algorithms.com/algebra/primality_tests.html", "verified": true}]},
