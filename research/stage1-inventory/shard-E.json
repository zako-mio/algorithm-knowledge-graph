    {"id": "anti-nim", "name": "反常Nim/Anti-Nim", "group_id": "G-E-6", "stage": "advanced", "priority": "P1", "brief": "misère规则：最后行动者输；反常Nim判定比正常复杂，需分类讨论全1堆与非全1堆", "sources": [{"type": "oiwiki", "url": "https://oi-wiki.org/math/game-theory/impartial-game/", "verified": true, "note": "反常Nim章节"}, {"type": "oiwiki", "url": "https://oi-wiki.org/math/game-theory/intro/", "verified": true, "note": "正常/反常博弈定义"}]},
